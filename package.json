{
  "name": "billing-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:turbo": "turbo run dev",
    "dev:web": "pnpm --filter @billing/web dev",
    "dev:api": "pnpm --filter @billing/api dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @billing/database db:generate",
    "db:migrate": "pnpm --filter @billing/database db:migrate",
    "db:push": "pnpm --filter @billing/database db:push"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
