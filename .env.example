# ==============================================================================
# Indian Billing & Accounting SaaS — Environment Template
# NOTE: This file defines variable names and structure ONLY.
# NEVER commit credentials, secrets, or real passwords into source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16 with RLS Enabled)
# ------------------------------------------------------------------------------
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?schema=public
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. Redis Configuration (BullMQ Queues & Cache)
# ------------------------------------------------------------------------------
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 3. API Service Configuration (NestJS Fastify / apps/api)
# ------------------------------------------------------------------------------
NODE_ENV=
PORT=
JWT_SECRET=
JWT_EXPIRES_IN=

# Reverse Proxy & Security Configuration
# TRUST_PROXY: Set to true, loopback, or specific CIDR if behind Nginx/Cloudflare
TRUST_PROXY=
# CORS_ORIGIN: Comma-separated list of allowed frontend origins (e.g. https://staging.example.com)
CORS_ORIGIN=
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Statutory Integrations (NIC e-Way Bill & e-Invoice via GSP / Sandbox)
# (Keep empty until authorized credentials and provider connectivity are active)
# ------------------------------------------------------------------------------
NIC_EWAY_BILL_CLIENT_ID=
NIC_EWAY_BILL_CLIENT_SECRET=
NIC_EWAY_BILL_USERNAME=
NIC_EWAY_BILL_PASSWORD=
NIC_EWAY_BILL_BASE_URL=
GST_EINVOICE_CLIENT_ID=
GST_EINVOICE_CLIENT_SECRET=
GST_EINVOICE_USERNAME=
GST_EINVOICE_PASSWORD=
GST_EINVOICE_BASE_URL=
GST_EWAY_CLIENT_SECRET=
GST_EWAY_PASSWORD=
GST_EWAY_BASE_URL=

# ------------------------------------------------------------------------------
# 4b. Outbound Email (registration OTP, password reset, invoices, reports)
# ------------------------------------------------------------------------------
# Example for Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_SECURE=false
# Use an app password, not the mailbox password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Inbox that receives in-app support and callback requests
SUPPORT_EMAIL=
# Automated tests set this to true. Leave unset for real registration OTP checks.
SKIP_EMAIL_OTP=

# ------------------------------------------------------------------------------
# 5. Web Frontend Configuration (Next.js 14 / apps/web)
# ------------------------------------------------------------------------------
# Public API endpoint accessible from the browser
NEXT_PUBLIC_API_URL=
# Internal API URL for Next.js server-side rewrites (e.g. http://127.0.0.1:4000/api/v1/:path*)
API_INTERNAL_URL=
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_DEFAULT_LOCALE=
# MUST be "false" in staging and production to prevent demo credentials on login page
NEXT_PUBLIC_ENABLE_DEMO_CREDENTIALS=

# ------------------------------------------------------------------------------
# 6. AI Smart Purchase Bill Scanner & OCR Configuration
# ------------------------------------------------------------------------------
# OCR_PROVIDER: "gemini", "local", or "mock" (defaults to "gemini" if GEMINI_API_KEY is set, else "local")
OCR_PROVIDER=
# Google Gemini API key for AI vision-based document extraction
GEMINI_API_KEY=
# Google Gemini Vision Model (e.g. gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=

# ------------------------------------------------------------------------------
# 7. Live GSTIN Taxpayer Verification & Autofill API
# ------------------------------------------------------------------------------
# GSTIN_PROVIDER: "gstin_cloud" (default), "appyflow", "gstinapi", or "mock" (offline test)
GSTIN_PROVIDER=gstin_cloud
# Official GSTIN.cloud API Key (obtain from https://gstin.cloud/dev-api/)
GSTIN_CLOUD_API_KEY=
# GSTIN.cloud base URL (default: https://gstin.cloud/api/v1)
GSTIN_CLOUD_BASE_URL=https://gstin.cloud/api/v1
# Provider timeout in milliseconds (default: 10000)
GSTIN_API_TIMEOUT_MS=10000
# In-memory cache TTL in seconds for validated results (default: 86400 = 24h)
GSTIN_CACHE_TTL_SECONDS=86400
# Legacy fallback API key (if using appyflow or gstinapi)
GSTIN_API_KEY=

