{
  "name": "@billing/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"if(fs.existsSync('.next/BUILD_ID')){try{fs.rmSync('.next',{recursive:true,force:true})}catch(e){}}\" && next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "clean": "node -e \"try{fs.rmSync('.next',{recursive:true,force:true});fs.rmSync('.next-dev',{recursive:true,force:true});fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})}catch(e){}\"",
    "type-check": "tsc --noEmit",
    "test:reliability": "node scripts/test-reliability.mjs",
    "lint": "next lint"
  },
  "dependencies": {
    "@billing/shared-types": "workspace:*",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "next": "16.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.5.3"
  },
  "devDependencies": {
    "@billing/tsconfig": "workspace:*",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.7.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3"
  }
}
